NODE_PORT=3000  # Port for the Dockerized Node.js server in .env.docker file. Change to 5000 or something else in .env file if running local Node.js
POSTGRES_DB=neurostudy
POSTGRES_USER=your_own_username
POSTGRES_PASSWORD=your_own_password
POSTGRES_HOST=db   # For .env.docker. Change to localhost in .env file if running local PostgreSQL
POSTGRES_PORT=5432 # For .env.docker. Change to 5433 in .env file if running local PostgreSQL
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=15m
CORS_ORIGIN=http://localhost:5173
APP_DB_USER=app_user
APP_DB_PASSWORD=app_password
DB_BRIDGE_PASSWORD=bridgepw