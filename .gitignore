# Build output
[Bb]in/
[Oo]bj/

# Velopack release output (Setup.exe, full/delta packages) — published to the
# update feed, never committed
neuuro_bridge/packaging/releases/

# SDK runtime logs (contain the license/developer code — never commit)
logs/

# Local secrets — keep the real .env out of git (the .env.example template is tracked)
.env
.env.docker

# Local dev TLS cert/key for Postgres (self-signed, generated per-machine — see README)
db/certs/*.crt
db/certs/*.key

# Local-only Docker Compose override (Windows bind-mount permission workaround — see the
# file's own header comment). Never applies on the Linux droplet.
compose.override.yml

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/

# Visual Studio
.vs/
*.user
*.suo

# Rider / VS Code
.idea/
.vscode/

# Node.js
node_modules/

# Certbot
certbot/conf/
certbot/www/

# Database
db/certs/*
!db/certs/.gitkeep

*.docx
*.pdf