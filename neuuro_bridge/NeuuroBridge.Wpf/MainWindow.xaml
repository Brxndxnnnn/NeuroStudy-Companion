<Window x:Class="NeuuroBridge.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NeuuroBridge.Wpf"
        Title="Neuuro Bridge" Height="820" Width="1280"
        MinHeight="680" MinWidth="1040"
        Background="{StaticResource Bg}" FontFamily="Segoe UI" Foreground="{StaticResource Ink}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════ HEADER ══════════════════════════ -->
        <Border Grid.Row="0" Height="56" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource Accent}" Margin="2,0,4,0" VerticalAlignment="Center"/>
                    <Ellipse Width="18" Height="18" Stroke="{StaticResource Accent}" StrokeThickness="1.5" Margin="-13,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Neuuro Bridge" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtAppVersion" Text="" Foreground="{StaticResource Muted2}" FontFamily="Consolas"
                               FontSize="11" Margin="8,3,0,0" VerticalAlignment="Bottom"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="6" Padding="9,5" Background="{StaticResource AccentSoft}" VerticalAlignment="Center" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="AuthDot" Width="8" Height="8" Fill="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtAuth" Text="not authenticated" VerticalAlignment="Center" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnReauth" Content="Re-auth" Click="BtnReauth_Click" IsEnabled="False"
                            Style="{StaticResource HeaderButtonSecondary}"
                            ToolTip="Re-attempt authentication with the license key. Use if raw EEG stays locked after connecting."/>
                    <ComboBox x:Name="CmbDevices" Width="170" Height="30" Margin="0,0,6,0" VerticalContentAlignment="Center"
                              DisplayMemberPath="DeviceName"
                              ToolTip="Select a discovered SenzeBand to connect to."/>
                    <Button x:Name="BtnScan" Content="Scan (12s)" Click="BtnScan_Click" IsEnabled="False"
                            Style="{StaticResource HeaderButton}"
                            ToolTip="Scan for nearby SenzeBands for 12 seconds. Make sure the band is ON and Bluetooth is enabled."/>
                    <Button x:Name="BtnConnect" Content="Connect" Click="BtnConnect_Click" IsEnabled="False"
                            Style="{StaticResource HeaderButton}"
                            ToolTip="Connect to the selected device. Enabled once a scan finds at least one band."/>
                    <Button x:Name="BtnDisconnect" Content="Disconnect" Click="BtnDisconnect_Click" IsEnabled="False"
                            Style="{StaticResource HeaderButtonSecondary}"
                            ToolTip="Disconnect from the band. If a session is uploading you'll be asked to confirm."/>
                    <Border CornerRadius="12" Padding="12,5" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource PanelEdge}"
                            BorderThickness="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ConnDot" Width="10" Height="10" Fill="{StaticResource Bad}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ConnPill" Text="Disconnected" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══════════════════════ SESSION STEPPER ══════════════════════ -->
        <!-- Pair → Baseline 1 → Images → Math → Baseline 2 → Survey saved.
             Dot/label x:Names are unchanged from the old vertical checklist (DotPgX / TxtPgX) so
             RefreshLiveState's progress logic in MainWindow.xaml.cs did not need to change — only
             SetStep's rendering did (Border+numeral+connecting line instead of a plain Ellipse). -->
        <StackPanel Grid.Row="1">
        <Border Style="{StaticResource Card}" Padding="24,16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" x:Name="DotPgPair" Width="26" Height="26" CornerRadius="13" BorderThickness="2">
                    <Border.Background><SolidColorBrush Color="#121A26"/></Border.Background>
                    <Border.BorderBrush><SolidColorBrush Color="#26344A"/></Border.BorderBrush>
                    <TextBlock x:Name="NumPgPair" Text="1" Tag="1" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Foreground><SolidColorBrush Color="#6B7A90"/></TextBlock.Foreground>
                    </TextBlock>
                </Border>
                <TextBlock Grid.Row="1" Grid.Column="0" x:Name="TxtPgPair" Text="Pair" FontSize="12" FontWeight="SemiBold" Opacity="0.55" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                <Rectangle Grid.Row="0" Grid.Column="1" x:Name="LinePgPair" Height="2" VerticalAlignment="Center" Margin="4,0">
                    <Rectangle.Fill><SolidColorBrush Color="#26344A"/></Rectangle.Fill>
                </Rectangle>

                <Border Grid.Row="0" Grid.Column="2" x:Name="DotPgRec" Width="26" Height="26" CornerRadius="13" BorderThickness="2">
                    <Border.Background><SolidColorBrush Color="#121A26"/></Border.Background>
                    <Border.BorderBrush><SolidColorBrush Color="#26344A"/></Border.BorderBrush>
                    <TextBlock x:Name="NumPgRec" Text="2" Tag="2" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Foreground><SolidColorBrush Color="#6B7A90"/></TextBlock.Foreground>
                    </TextBlock>
                </Border>
                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="TxtPgRec" Text="Baseline 1" FontSize="12" FontWeight="SemiBold" Opacity="0.55" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                <Rectangle Grid.Row="0" Grid.Column="3" x:Name="LinePgRec" Height="2" VerticalAlignment="Center" Margin="4,0">
                    <Rectangle.Fill><SolidColorBrush Color="#26344A"/></Rectangle.Fill>
                </Rectangle>

                <Border Grid.Row="0" Grid.Column="4" x:Name="DotPgImg" Width="26" Height="26" CornerRadius="13" BorderThickness="2">
                    <Border.Background><SolidColorBrush Color="#121A26"/></Border.Background>
                    <Border.BorderBrush><SolidColorBrush Color="#26344A"/></Border.BorderBrush>
                    <TextBlock x:Name="NumPgImg" Text="3" Tag="3" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Foreground><SolidColorBrush Color="#6B7A90"/></TextBlock.Foreground>
                    </TextBlock>
                </Border>
                <TextBlock Grid.Row="1" Grid.Column="4" x:Name="TxtPgImg" Text="Images" FontSize="12" FontWeight="SemiBold" Opacity="0.55" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                <Rectangle Grid.Row="0" Grid.Column="5" x:Name="LinePgImg" Height="2" VerticalAlignment="Center" Margin="4,0">
                    <Rectangle.Fill><SolidColorBrush Color="#26344A"/></Rectangle.Fill>
                </Rectangle>

                <Border Grid.Row="0" Grid.Column="6" x:Name="DotPgMath" Width="26" Height="26" CornerRadius="13" BorderThickness="2">
                    <Border.Background><SolidColorBrush Color="#121A26"/></Border.Background>
                    <Border.BorderBrush><SolidColorBrush Color="#26344A"/></Border.BorderBrush>
                    <TextBlock x:Name="NumPgMath" Text="4" Tag="4" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Foreground><SolidColorBrush Color="#6B7A90"/></TextBlock.Foreground>
                    </TextBlock>
                </Border>
                <TextBlock Grid.Row="1" Grid.Column="6" x:Name="TxtPgMath" Text="Math" FontSize="12" FontWeight="SemiBold" Opacity="0.55" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                <Rectangle Grid.Row="0" Grid.Column="7" x:Name="LinePgMath" Height="2" VerticalAlignment="Center" Margin="4,0">
                    <Rectangle.Fill><SolidColorBrush Color="#26344A"/></Rectangle.Fill>
                </Rectangle>

                <Border Grid.Row="0" Grid.Column="8" x:Name="DotPgEnd" Width="26" Height="26" CornerRadius="13" BorderThickness="2">
                    <Border.Background><SolidColorBrush Color="#121A26"/></Border.Background>
                    <Border.BorderBrush><SolidColorBrush Color="#26344A"/></Border.BorderBrush>
                    <TextBlock x:Name="NumPgEnd" Text="5" Tag="5" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Foreground><SolidColorBrush Color="#6B7A90"/></TextBlock.Foreground>
                    </TextBlock>
                </Border>
                <TextBlock Grid.Row="1" Grid.Column="8" x:Name="TxtPgEnd" Text="Baseline 2" FontSize="12" FontWeight="SemiBold" Opacity="0.55" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                <Rectangle Grid.Row="0" Grid.Column="9" x:Name="LinePgEnd" Height="2" VerticalAlignment="Center" Margin="4,0">
                    <Rectangle.Fill><SolidColorBrush Color="#26344A"/></Rectangle.Fill>
                </Rectangle>

                <Border Grid.Row="0" Grid.Column="10" x:Name="DotPgSurvey" Width="26" Height="26" CornerRadius="13" BorderThickness="2">
                    <Border.Background><SolidColorBrush Color="#121A26"/></Border.Background>
                    <Border.BorderBrush><SolidColorBrush Color="#26344A"/></Border.BorderBrush>
                    <TextBlock x:Name="NumPgSurvey" Text="6" Tag="6" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Foreground><SolidColorBrush Color="#6B7A90"/></TextBlock.Foreground>
                    </TextBlock>
                </Border>
                <TextBlock Grid.Row="1" Grid.Column="10" x:Name="TxtPgSurvey" Text="Survey saved" FontSize="12" FontWeight="SemiBold" Opacity="0.55" HorizontalAlignment="Center" Margin="0,7,0,0"/>
            </Grid>
        </Border>

        <!-- Questionnaire scores (BFI-2 domains, WHO-5 well-being), read from the
             session_questionnaire_scores view once the website starts saving answers. Display-only. -->
        <Border x:Name="PanelScores" Style="{StaticResource Card}" Padding="24,12" Margin="0,0,0,12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <TextBlock Style="{StaticResource CardTitle}" Text="WHO-5 WELL-BEING"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtWho5Score" Text="—" FontSize="26" FontFamily="Consolas" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtWho5Raw" Text="" Foreground="{StaticResource Muted2}" FontSize="14" VerticalAlignment="Bottom" Margin="10,0,0,4"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtWho5Note" Text="" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource CardTitle}" Text="BFI-2 PERSONALITY (MEAN SCORE, 1–5)"/>
                    <UniformGrid x:Name="BfiGrid" Columns="5"/>
                    <TextBlock x:Name="TxtBfiNote" Text="" Foreground="{StaticResource Muted2}" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        </StackPanel>

        <!-- ══════════════════════════ BODY ══════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto" MinHeight="196"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Live chart: full-bleed now that the left control column is gone. Tabs + HR/SpO2
                 readouts live inside LiveEegPanel itself (same row, see LiveEegPanel.xaml) so they
                 can share one header strip without reaching into the TabControl's template. -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                <local:LiveEegPanel x:Name="LivePanel"/>
            </Border>

            <!-- Bottom status rail: pairing / signal & battery / database upload / action stack. -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" MinWidth="200"/>
                </Grid.ColumnDefinitions>

                <!-- Pairing code card -->
                <Border Grid.Column="0" Style="{StaticResource StatusCard}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource CardTitle}" Text="PAIRING" Margin="0" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Ellipse x:Name="SyncDot" Width="9" Height="9" Fill="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock x:Name="TxtSyncStatus" Text="—" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <Button x:Name="BtnCopyPairing" DockPanel.Dock="Right" Content="Copy" Click="BtnCopyPairing_Click"
                                    IsEnabled="False" Style="{StaticResource Secondary}" Padding="10,5" VerticalAlignment="Center" Margin="8,0,0,0"
                                    ToolTip="Copy the pairing code to the clipboard."/>
                            <TextBlock x:Name="TxtPairing" Text="—" FontSize="34" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource Accent}"/>
                        </DockPanel>
                        <TextBlock Text="Enter this code on the web frontend to claim the session."
                                   Foreground="{StaticResource Muted2}" FontSize="14" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Session ID " Foreground="{StaticResource Muted2}" FontSize="14"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtSessionId" Text="—" FontSize="14" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Started " Foreground="{StaticResource Muted2}" FontSize="14"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtStarted" Text="—" FontSize="14" FontFamily="Consolas"/>
                        </Grid>
                        <DockPanel Margin="0,10,0,0">
                            <Ellipse x:Name="RecDot" DockPanel.Dock="Left" Width="9" Height="9" Fill="{StaticResource Bad}" VerticalAlignment="Center"
                                     Margin="0,0,6,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="TxtElapsed" Text="" Foreground="{StaticResource Bad}" FontWeight="SemiBold" FontFamily="Consolas" FontSize="14" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="Press Start Session once the website shows this session as claimed. The website ends the session; Stop below is a failsafe only."
                                   Foreground="{StaticResource Muted2}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtPairHint" Text="Waiting to pair with website…"
                                   Foreground="{StaticResource Warn}" FontSize="12" Margin="0,4,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Signal & battery card -->
                <Border Grid.Column="1" Style="{StaticResource StatusCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="SIGNAL &amp; BATTERY"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Signal quality" Foreground="{StaticResource Muted2}" FontSize="14"/>
                            <TextBlock Grid.Column="1" x:Name="TxtQuality" Text="—" FontWeight="SemiBold" FontSize="14"/>
                        </Grid>
                        <ProgressBar x:Name="BarQuality" Height="8" Minimum="0" Maximum="100" Value="0" Margin="0,6,0,10"
                                     Foreground="{StaticResource Good}" Background="#22303F" BorderThickness="0"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Signal state" Foreground="{StaticResource Muted2}" FontSize="14"/>
                            <TextBlock Grid.Column="1" x:Name="TxtSignal" Text="—" FontSize="14"/>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Battery" Foreground="{StaticResource Muted2}" FontSize="14"/>
                            <TextBlock Grid.Column="1" x:Name="TxtBattery" Text="—" FontSize="14"/>
                        </Grid>
                        <ItemsControl x:Name="ChannelList" Margin="0,10,0,0" FontSize="12"/>
                        <TextBlock x:Name="TxtQualitySummary" Text="" FontSize="12" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Database upload card -->
                <Border Grid.Column="2" Style="{StaticResource StatusCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="DATABASE UPLOAD"/>
                        <TextBlock x:Name="TxtDbState" Text="not started" FontWeight="SemiBold" FontSize="14"/>
                        <UniformGrid Columns="3" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock x:Name="TxtRawRows" Text="0" FontSize="20" FontFamily="Consolas" FontWeight="Bold"/>
                                <TextBlock Text="raw rows" Foreground="{StaticResource Muted2}" FontSize="10"/>
                                <TextBlock x:Name="TxtRawExp" Text="" Foreground="{StaticResource Muted2}" FontSize="10"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="TxtFiltRows" Text="0" FontSize="20" FontFamily="Consolas" FontWeight="Bold"/>
                                <TextBlock Text="filtered rows" Foreground="{StaticResource Muted2}" FontSize="10"/>
                                <TextBlock x:Name="TxtFiltExp" Text="" Foreground="{StaticResource Muted2}" FontSize="10"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="TxtBandRows" Text="0" FontSize="20" FontFamily="Consolas" FontWeight="Bold"/>
                                <TextBlock Text="band rows" Foreground="{StaticResource Muted2}" FontSize="10"/>
                                <TextBlock x:Name="TxtBandExp" Text="" Foreground="{StaticResource Muted2}" FontSize="10"/>
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock x:Name="TxtDbVolume" Text="" Foreground="{StaticResource Muted2}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtDbSummary" Text="" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Margin="0,6,0,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="TxtDbExtra" Text="" Foreground="{StaticResource Muted2}" FontSize="12" Margin="0,6,0,0"/>
                        <TextBlock x:Name="TxtDbError" Text="" Foreground="{StaticResource Bad}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Action stack: primary → destructive → secondary → utility. Start Session is now the
                     technician's main call to action (client requirement #8: the bridge owns starting
                     a session, not the website) — enabled only once the website shows the session as
                     claimed (see RefreshSessionHint in MainWindow.xaml.cs). -->
                <StackPanel Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Top">
                    <Button x:Name="BtnStartSession" Content="Start Session" Click="BtnStartSession_Click" IsEnabled="False"
                            Background="{StaticResource Good}" Style="{StaticResource RailButton}"
                            ToolTip="Begin recording for the claimed session. Enabled once the website shows the session as claimed."/>
                    <Button x:Name="BtnStopSession" Content="Stop session (failsafe)"
                            Click="BtnStopSession_Click" IsEnabled="False" Background="{StaticResource Bad}" Style="{StaticResource RailButton}"
                            ToolTip="Hardware-side abort: use only if the website cannot end the session (browser crash, network loss). Flushes and closes the upload; the band stays connected."/>
                    <Button x:Name="BtnCapture" Content="Start test recording" Click="BtnCapture_Click" IsEnabled="False"
                            Style="{StaticResource RailButtonSecondary}"
                            ToolTip="Record band data WITHOUT conducting a client session — for equipment testing and standalone data collection. Saves one CSV: raw ADC, raw µV, filtered µV, heart rate, SpO₂, attention, relaxation, mental workload and signal quality (independent of the database upload)."/>
                    <TextBlock x:Name="TxtCapture" Text="idle" Foreground="{StaticResource Muted2}" FontSize="12" Margin="2,-4,0,10" HorizontalAlignment="Center"/>
                    <Button x:Name="BtnToggleLog" Content="Show log ▼" Click="BtnToggleLog_Click"
                            Style="{StaticResource RailButtonSecondary}"/>
                </StackPanel>
            </Grid>

            <!-- Collapsible log: 0-height by default, animated open/closed (MainWindow.xaml.cs). -->
            <Border Grid.Row="2" x:Name="LogPanel" Height="0" ClipToBounds="True" Style="{StaticResource Card}" Margin="0,10,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="LOG"/>
                    <RichTextBox x:Name="LogBox" IsReadOnly="True" IsDocumentEnabled="False" Background="Transparent"
                                 Foreground="{StaticResource Muted2}" BorderThickness="0" Padding="0"
                                 FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
