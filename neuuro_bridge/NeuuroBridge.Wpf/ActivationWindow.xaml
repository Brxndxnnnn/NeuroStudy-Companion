<Window x:Class="NeuuroBridge.Wpf.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NeuuroBridge — Activation"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}">
    <Border Style="{StaticResource Card}" Margin="14">
        <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="ACTIVATE THIS MACHINE"/>
            <TextBlock Foreground="{StaticResource Ink}" FontSize="13" TextWrapping="Wrap"
                       Text="This machine is not set up yet. Enter the activation code provided by the study administrator — it connects this bridge to your clinic. You only do this once."/>
            <TextBox x:Name="CodeBox" Margin="0,14,0,0" FontSize="18" Padding="10,8"
                     FontFamily="Consolas" CharacterCasing="Upper"
                     Background="#0F1722" Foreground="{StaticResource Ink}"
                     BorderBrush="{StaticResource PanelEdge}" BorderThickness="1"
                     KeyDown="CodeBox_KeyDown"/>
            <TextBlock x:Name="StatusText" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource Muted2}"
                       Text="Codes look like XXXX-XXXX-XXXX."/>
            <DockPanel Margin="0,14,0,0">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource Muted}" x:Name="MachineText"/>
                <Button x:Name="ActivateBtn" Content="Activate" HorizontalAlignment="Right"
                        Margin="0" Click="ActivateBtn_Click"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
