<UserControl x:Class="NeuuroBridge.Wpf.LiveEegPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="clr-namespace:ScottPlot;assembly=ScottPlot.WPF">
    <UserControl.Resources>
        <!-- Paper-style strip-chart tabs, adapted to the app's dark theme. -->
        <Style x:Key="ChartTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#92A2B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="14,7">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#E6EDF6"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#C2CCDA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChartTabs" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="#26344A" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" Background="Transparent" HorizontalAlignment="Left"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <TabControl Style="{StaticResource ChartTabs}">
        <TabItem Header="EEG Waves" Style="{StaticResource ChartTabItem}">
            <Border Background="#0B121C" CornerRadius="6" ClipToBounds="True" Margin="0,8,0,0">
                <sp:WpfPlot x:Name="EegPlot"/>
            </Border>
        </TabItem>
        <TabItem Header="Frequency Bands" Style="{StaticResource ChartTabItem}">
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel x:Name="BandChannelBar" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6"/>
                <Border Grid.Row="1" Background="#0B121C" CornerRadius="6" ClipToBounds="True">
                    <sp:WpfPlot x:Name="BandPlot"/>
                </Border>
            </Grid>
        </TabItem>
        <TabItem Header="Mental States" Style="{StaticResource ChartTabItem}">
            <Border Background="#0B121C" CornerRadius="6" ClipToBounds="True" Margin="0,8,0,0">
                <sp:WpfPlot x:Name="CogPlot"/>
            </Border>
        </TabItem>
    </TabControl>
</UserControl>
