<!-- No StartupUri: App.OnStartup gates on activation before showing MainWindow. -->
<Application x:Class="NeuuroBridge.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Palette -->
        <SolidColorBrush x:Key="Bg"        Color="#0F1722"/>
        <SolidColorBrush x:Key="Panel"     Color="#17202E"/>
        <SolidColorBrush x:Key="PanelEdge" Color="#26344A"/>
        <SolidColorBrush x:Key="Ink"       Color="#E6EDF6"/>
        <SolidColorBrush x:Key="Muted"     Color="#6B7A90"/>
        <SolidColorBrush x:Key="Muted2"    Color="#92A2B8"/>
        <SolidColorBrush x:Key="Accent"    Color="#3B82F6"/>
        <SolidColorBrush x:Key="Good"      Color="#22C55E"/>
        <SolidColorBrush x:Key="Warn"      Color="#F59E0B"/>
        <SolidColorBrush x:Key="Bad"       Color="#EF4444"/>

        <!-- Redesign tokens (bridge UI/UX pass) -->
        <SolidColorBrush x:Key="Panel2"     Color="#121A26"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#1E2A3C"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Subtle dim on hover/press so the flat-fill buttons read as responsive. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.90"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#2A3647"/>
                    <Setter Property="Foreground" Value="#6B7A90"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary (lower-emphasis) button — was inline Background="#334155" on several buttons. -->
        <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#334155"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelEdge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted2}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Bottom status-rail card: darker than the standard Card, generous padding — this rail
             carries operational info a technician reads at a glance (see MainWindow.xaml). -->
        <Style x:Key="StatusCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelEdge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,20"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <!-- Compact button variants for the header row, which has far less vertical room than a card. -->
        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="HeaderButtonSecondary" TargetType="Button" BasedOn="{StaticResource Secondary}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- Rail button stack: primary/destructive/utility, ~13px text, ~11px vertical padding. -->
        <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RailButtonSecondary" TargetType="Button" BasedOn="{StaticResource RailButton}">
            <Setter Property="Background" Value="{StaticResource PanelEdge}"/>
        </Style>
    </Application.Resources>
</Application>
