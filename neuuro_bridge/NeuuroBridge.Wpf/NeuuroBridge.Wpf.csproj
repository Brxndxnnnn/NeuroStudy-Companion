<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Must stay x64: Core loads the native x64 SenzeBandCore.dll. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <RootNamespace>NeuuroBridge.Wpf</RootNamespace>
    <AssemblyName>NeuuroBridge.Wpf</AssemblyName>
    <Nullable>disable</Nullable>
    <!-- Single source of truth for the release version: packaging/pack.ps1 reads it
         and passes it to vpk; UpdateService shows it; bump it per release. -->
    <Version>1.0.7</Version>
    <!-- Explicit Main (Program.cs) so VelopackApp.Build().Run() precedes WPF startup. -->
    <StartupObject>NeuuroBridge.Wpf.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NeuuroBridge.Core\NeuuroBridge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

</Project>
