<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <!-- Must stay x64: the Core library loads the native x64 SenzeBandCore.dll. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <RootNamespace>NeuuroBridge</RootNamespace>
    <AssemblyName>NeuuroBridge</AssemblyName>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The engine (SDK wrapper, DB uploader, FFT) + its SDK/Npgsql deps live in Core now. -->
    <ProjectReference Include="..\NeuuroBridge.Core\NeuuroBridge.Core.csproj" />
  </ItemGroup>

</Project>
