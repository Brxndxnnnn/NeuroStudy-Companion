<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <!-- SenzeBandCore.dll is a native x64 (mixed-mode) assembly, so the whole app must run as x64. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <RootNamespace>NeuuroBridge</RootNamespace>
    <AssemblyName>NeuuroBridge</AssemblyName>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- PostgreSQL/TimescaleDB client. 6.0.x is the last line that still targets
         netstandard2.0, so it runs on .NET Framework 4.8 (7.0+ require net6.0+). -->
    <PackageReference Include="Npgsql" Version="6.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Neeuro SenzeBand SDK (STANDARD tier). Copied into lib\ from the BrainTech example. -->
    <Reference Include="SenzeBandSDK">
      <HintPath>lib\SenzeBandSDK.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SenzeBandCore">
      <HintPath>lib\SenzeBandCore.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
