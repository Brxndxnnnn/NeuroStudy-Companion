# Copy this file to ".env" (same folder) and fill in your key.
# The real .env is gitignored, so your key stays local.
NEUURO_LICENSE_KEY=your-license-key-here

# ── Direct DB upload (TS1.6) ──────────────────────────────────────────────────
# Bridge writes EEG straight to TimescaleDB. These are OPTIONAL: if omitted, the
# bridge falls back to the dev compose defaults below (localhost:5433). Override
# only if your DB runs elsewhere.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=neurostudy
POSTGRES_USER=neurostudy_user
POSTGRES_PASSWORD=neurostudy_pass

# ── Packaging / activation (dev) ──────────────────────────────────────────────
# Dev boxes: skip the first-run activation dialog and just use this .env.
# Clinic machines are activated instead (no .env at all) — see
# docs/bridge-packaging-plan.md §4.
ACTIVATION_OPTIONAL=true
# Optional overrides for local testing (defaults live in BridgeSettings.cs):
#ACTIVATION_URL=http://localhost:8765/bridge/activate
#UPDATE_FEED_URL=C:\path\to\local\feed
#POSTGRES_SSLMODE=require   # set by activation in prod; not needed for dev compose
