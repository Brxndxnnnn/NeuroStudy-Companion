# Copy this file to ".env" (same folder) and fill in your key.
# The real .env is gitignored, so your key stays local.
NEUURO_LICENSE_KEY=your-license-key-here

# ── Direct DB upload (TS1.6) ──────────────────────────────────────────────────
# Bridge writes EEG straight to TimescaleDB. These are OPTIONAL: if omitted, the
# bridge falls back to the dev compose defaults below (localhost:5433). Override
# only if your DB runs elsewhere.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=neurostudy
POSTGRES_USER=neurostudy_user
POSTGRES_PASSWORD=neurostudy_pass
